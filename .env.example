# Copy this file to .env and adjust as needed.
# On TrueNAS Scale: place .env next to docker-compose.yml.
# For local dev: copy to .env.local instead.
#
# There is NO site password. Access is controlled entirely by the per-league
# access codes in config/leagues.json (see config/leagues.example.json).

# --- Optional (defaults shown) ---
SERVER_PORT=3001
CACHE_DIR=/app/cache        # SQLite DB, JSON cache and the auto-generated session key live here
NODE_ENV=production

# Signs the session cookie. Optional — if unset, a random key is generated once
# and persisted to <CACHE_DIR>/.session-secret (survives restarts). Set this
# explicitly only if you run multiple instances behind a load balancer.
#SESSION_SECRET=

# Override where the league config is read from (default: ./config/leagues.json)
#LEAGUES_CONFIG_PATH=/app/config/leagues.json

# --- Draft board (optional, editable in the UI too) ---
VITE_LIVE_DRAFT_ID=
VITE_MOCK_DRAFT_ID=
