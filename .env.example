# Copy this file to .env and fill in your values.
# On TrueNAS Scale: place .env in the same directory as docker-compose.yml.
# For local dev: copy to .env.local instead.

# --- Required ---
SITE_PASSWORD=choose_a_strong_password

# Signs the session cookie for the per-league access-code login. Use a long
# random string. If unset, a key is derived from SITE_PASSWORD (sessions then
# reset whenever SITE_PASSWORD changes).
SESSION_SECRET=generate_a_long_random_string

# --- League configuration ---
# Preferred: mount config/leagues.json (see config/leagues.example.json) as a
# volume. It defines every league, its URL slug, its Sleeper ID and its access
# code. When that file is present, LEAGUE_ID below is ignored.
#
# Single-league fallback: if config/leagues.json is absent, set LEAGUE_ID and the
# server synthesizes a one-league ("sdff") config from it.
LEAGUE_ID=your_sleeper_league_id_here

# Override where the league config file is read from (default: ./config/leagues.json)
#LEAGUES_CONFIG_PATH=/app/config/leagues.json

# --- Announcements / admin ---
# Unlocks the /admin panel. Also usable as the admin access code.
ADMIN_PASSWORD=choose_a_strong_admin_password

# --- Optional (defaults shown) ---
SERVER_PORT=3001
CACHE_DIR=/app/cache
# SQLite file for historical data (default: <CACHE_DIR>/sdff.db)
#DB_PATH=/app/cache/sdff.db
NODE_ENV=production

# --- Draft board (optional, editable in UI too) ---
VITE_LIVE_DRAFT_ID=           # Sleeper draft ID for the active draft
VITE_MOCK_DRAFT_ID=           # Sleeper draft ID to use as ADP baseline
