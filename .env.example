# Copy this file to .env and fill in your values.
# On TrueNAS Scale: place .env in the same directory as docker-compose.yml.
# For local dev: copy to .env.local instead.

# --- Required ---
LEAGUE_ID=your_sleeper_league_id_here
SITE_PASSWORD=choose_a_strong_password

# --- Announcements admin (recommended) ---
# Set this to unlock the /admin panel for posting league announcements.
# Keep it secret — only the commissioner should know it.
ADMIN_PASSWORD=choose_a_strong_admin_password

# --- Optional (defaults shown) ---
SERVER_PORT=7780
CACHE_DIR=/app/cache
NODE_ENV=production

# --- Draft board (optional, editable in UI too) ---
VITE_LIVE_DRAFT_ID=           # Sleeper draft ID for the active draft
VITE_MOCK_DRAFT_ID=           # Sleeper draft ID to use as ADP baseline
