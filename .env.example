# All optional. Copy to .env.local for local dev, or set in the container's
# environment. Every setting has a working default; the app is configured from
# its own Settings screen (commissioner password + leagues), not from here.

SERVER_PORT=3001
CACHE_DIR=/app/cache          # SQLite DB, JSON cache, auto-generated session key
NODE_ENV=production
TZ=America/New_York

# Signs the session cookie. If unset, a random key is generated once and
# persisted to <CACHE_DIR>/.session-secret. Only set this for multi-replica.
#SESSION_SECRET=

#AUTO_BACKFILL=0     # disable the first-run / new-league self-backfill
#SYNC_ENABLED=0      # disable the background refresh scheduler
#SYNC_IN_DEV=1       # enable the scheduler in local dev
#RESET_ADMIN=1       # clear the commissioner password (leagues kept) then unset

# One-time import of an old {leagues, adminCode} config into a fresh DB.
# Ignored once the DB has leagues.
#LEAGUES_JSON=

# --- Draft board (optional, editable in the UI too) ---
VITE_LIVE_DRAFT_ID=
VITE_MOCK_DRAFT_ID=
