# Copy to .env.local for local dev, or set these in your container's environment.
# Everything here is OPTIONAL — every setting has a working default.
#
# There is no site password. Access = the per-league access codes in the
# league config (config/leagues.json locally, or the LEAGUES_JSON env var).

# The whole league config, inline (raw JSON or base64). Overrides the file.
# This is the deployment-friendly path — no volume-mounted file needed.
#LEAGUES_JSON={"adminCode":"...","leagues":[{"slug":"sdff","displayName":"...","currentLeagueId":"123","type":"dynasty","sortOrder":1,"accessCode":"SDFF"}]}

# Config file path when NOT using LEAGUES_JSON (default: ./config/leagues.json)
#LEAGUES_CONFIG_PATH=/app/config/leagues.json

SERVER_PORT=3001
CACHE_DIR=/app/cache          # SQLite DB, JSON cache, auto-generated session key
#DB_PATH=/app/cache/sdff.db
NODE_ENV=production
TZ=America/New_York

# Signs the session cookie. If unset, a random key is generated once and
# persisted to <CACHE_DIR>/.session-secret. Only set this for multi-replica.
#SESSION_SECRET=

#AUTO_BACKFILL=0              # disable the first-run self-populate
#SYNC_ENABLED=0              # disable the background refresh scheduler
#SYNC_IN_DEV=1              # enable the scheduler in local dev

# --- Draft board (optional, editable in the UI too) ---
VITE_LIVE_DRAFT_ID=
VITE_MOCK_DRAFT_ID=
